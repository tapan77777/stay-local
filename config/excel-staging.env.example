# Copy to .env.excel-staging.local (ignored), chmod 600, then replace every placeholder.
# Confirm these identify a NEW nonproduction Neon branch in the Console.
# Do not edit .env.local, and do not paste production credentials here.
DATABASE_URL=postgresql://STAGING_ROLE:REPLACE_WITH_STAGING_PASSWORD@STAGING_POOLED_HOST/neondb?sslmode=require
ADMIN_SESSION_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET
PLAN_ACCESS_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
PLAN_MIGRATION_ENV=staging
PLAN_MIGRATION_DATABASE_URL=postgresql://STAGING_ROLE:REPLACE_WITH_STAGING_PASSWORD@STAGING_DIRECT_HOST/neondb?sslmode=require
PLAN_MIGRATION_EXPECTED_HOST=REPLACE_WITH_STAGING_DIRECT_HOST
PLAN_MIGRATION_EXPECTED_BRANCH_ID=REPLACE_WITH_VERIFIED_STAGING_BRANCH_ID
ADMIN_PASSWORD=REPLACE_WITH_NEW_STAGING_ADMIN_PASSWORD
