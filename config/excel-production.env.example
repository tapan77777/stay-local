# Preparation only. Copy privately to .env.excel-production.local (ignored), mode 600.
# Do not supply secrets in chat, Git, command arguments, or this example.
# Obtain BOTH URLs from the branch independently confirmed as stay-local's live database.
DATABASE_URL=REPLACE_WITH_VERIFIED_PRODUCTION_POOLED_URL
PLAN_PRODUCTION_DIRECT_URL=REPLACE_WITH_VERIFIED_PRODUCTION_DIRECT_URL
PLAN_PRODUCTION_EXPECTED_BRANCH_ID=REPLACE_AFTER_READ_ONLY_VERIFICATION
PLAN_PRODUCTION_EXPECTED_PROJECT_ID=REPLACE_AFTER_READ_ONLY_VERIFICATION
# Existing production admin/access secrets stay unchanged in Vercel.
# This file MUST NOT be loaded by plan:migrate or scripts/staging/*.

# Set yes ONLY after owner confirms this matches stay-local Production, not by branch name alone.
PLAN_PRODUCTION_IDENTITY_CONFIRMED=no
