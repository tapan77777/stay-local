{
  "name": "staylocal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/maplibre/maplibre-gl-worker.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "plan:migrate": "node scripts/plan-migrate.mjs",
    "plan:test:devices": "node scripts/plan-devices-test.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "plan:test:excel": "node --import tsx --test tests/excel.test.ts",
    "plan:test:devices:isolated": "node --import ./tests/isolated-neon.mjs scripts/plan-devices-test.mjs",
    "plan:test:app:isolated": "node tests/excel-app-smoke.mjs",
    "plan:test:browser:isolated": "node tests/excel-app-smoke.mjs --browser"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "6.12.0",
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "1.64.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.9"
}
